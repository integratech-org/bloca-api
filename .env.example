# =============================================================================
# General / Django
# =============================================================================
DEBUG=on
SECRET_KEY=

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Credentials used by the Postgres container/service
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# App connection string (must match the values above)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# =============================================================================
# Cache / Queue (Redis)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CORS
# =============================================================================
# Comma-separated for multiple origins (e.g. http://localhost:5173,http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# Email (SMTP)
# =============================================================================
# For local dev, you can use MailHog/Mailpit on port 1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BLOCA <noreply@example.com>"

# =============================================================================
# Object Storage (S3-compatible)
# =============================================================================
# Works with AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces, etc.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
